# Copy this file to .env. The server reads it at startup.
PORT=4100
AEGIS_BASE_URL=https://aegis.example.com
AEGIS_DEMO=0                  # 1 loads demo tenants, mock HRMS and demo controls
AEGIS_SECRET=change-me        # encrypts stored documents and connector credentials
AEGIS_DATA=/var/lib/aegis

# Optional AI. Easiest: paste a key in Settings > AI Engine instead.
AEGIS_LLM_PROVIDER=deepseek   # deepseek or anthropic
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# Optional Slack
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
