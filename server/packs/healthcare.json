     "holder_name"
    ]
   },
   "remediation": {
    "request_days_before": 30,
    "reminder_every_days": 3,
    "max_reminders": 2,
    "route": "worker"
   }
  },
  {
   "key": "CTRL-HC-ORIENT",
   "name": "Facility orientation",
   "requirement_type": "contract",
   "source": "Client contract",
   "subject": "worker",
   "type": "document_required",
   "priority": "medium",
   "applies_when": {
    "facility_requires": "facility_orientation",
    "category": [
     "clinical"
    ]
   },
   "params": {},
   "evidence": {
    "doc_types": [
     "facility_orientation"
    ],
    "auto_accept": true,
    "required_fields": [
